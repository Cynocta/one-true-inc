// Rama main: página de Próximamente en el dominio de One True.
// Archivos estáticos (Next.js export en ./out) + Worker para /api/* (lista de lanzamiento en Supabase).
// La rama develop tiene su propia config (sitio completo, Worker "onetrue-develop").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onetrue-proximamente",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://rtaflovadzoanspemxbh.supabase.co"
  },
  // Secreto obligatorio: npx wrangler secret put SUPABASE_SECRET_KEY
  "observability": { "enabled": true },
  // Dominio de One True (zona activa en Cloudflare). Cloudflare crea los registros DNS al desplegar;
  // si ya existen registros A/AAAA/CNAME para @ o www, hay que borrarlos antes del primer deploy.
  "routes": [
    { "pattern": "onetrueinc.com", "custom_domain": true },
    { "pattern": "www.onetrueinc.com", "custom_domain": true }
  ]
}
